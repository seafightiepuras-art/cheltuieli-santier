# Supabase — din Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cheie de service, DOAR pe server (scriere avize/facturi) — nu o expune niciodata in client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — pentru extragerea datelor din poza avizului/facturii (Claude vision)
# NU se expune niciodata in client — folosita doar in src/app/api/ocr/route.ts
ANTHROPIC_API_KEY=sk-ant-...
